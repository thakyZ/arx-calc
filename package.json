{
  "name": "arx-calc",
  "description": "Elite Dangerous ARX Calculator",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.2.1",
    "@mui/material": "^6.2.1",
    "@mui/styles": "^6.2.1",
    "lodash": "^4.17.21",
    "mathjs": "^14.0.1",
    "msw": "^2.7.0",
    "react": "^17.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "vite-plugin-checker": "^0.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ci": "vitest run --reporter verbose --reporter=junit --outputFile=./unit-report.xml",
    "preview": "vite preview",
    "lint": "CI=true eslint --ignore-pattern '*.d.ts' --ignore-pattern '*.test.*' --ext ts,tsx --max-warnings 0 src",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "last 2 versions"
    ],
    "development": [
      "last 1 version"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
